    local function SetActiveTab(tab)
        if Window._activeTab == tab then return end
        Window._activeTab = tab

        -- hide all pages, show active
        for _, t in pairs(Window._tabs) do
            t._page.Visible = false
        end
        tab._page.Visible = true

        -- update sidebar button styles
        for _, btn in pairs(Window._tabButtons) do
            local isActive = (btn._tab == tab)
            Tween(btn._frame, {
                BackgroundColor3 = isActive and Color3.fromRGB(35, 25, 50) or Color3.fromRGB(0,0,0),
                BackgroundTransparency = isActive and 0 or 1,
            })
            Tween(btn._label, {
                TextColor3 = isActive and Theme.TabActive or Theme.TabText,
            })
            if btn._bar then
                btn._bar.Visible = isActive
            end
        end
    end

