            function Section:AddDropdown(cfg)
                cfg = cfg or {}
                local Name     = cfg.Name     or "Dropdown"
                local Desc     = cfg.Desc
                local Options  = cfg.Options  or {}
                local Default  = cfg.Default  or (Options[1] or "")
                local Callback = cfg.Callback or function() end
                local Multi    = cfg.Multi    or false

                local rowH = Desc and 52 or 42
                local Row = MakeRow(rowH)

                Create("TextLabel", {
                    Parent = Row,
                    Size   = UDim2.new(1, 0, 0, 16),
                    Position = UDim2.new(0, 12, 0, Desc and 7 or 5),
                    BackgroundTransparency = 1,
                    Text  = Name,
                    Font  = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = Theme.TextPrimary,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                if Desc then
                    Create("TextLabel", {
                        Parent = Row,
                        Size   = UDim2.new(1, 0, 0, 12),
                        Position = UDim2.new(0, 12, 0, 24),
                        BackgroundTransparency = 1,
                        Text  = Desc,
                        Font  = Enum.Font.Gotham,
                        TextSize = 10,
                        TextColor3 = Theme.TextSecondary,
                        TextXAlignment = Enum.TextXAlignment.Left,
                    })
                end

                local DDFrame = Create("Frame", {
                    Parent = Row,
                    Size   = UDim2.new(1, -24, 0, 26),
                    Position = UDim2.new(0, 12, 1, -34),
                    BackgroundColor3 = Theme.InputBg,
                })
                MakeCorner(DDFrame, 5)
                MakeStroke(DDFrame, Theme.Border, 1)

                local DDLabel = Create("TextLabel", {
                    Parent = DDFrame,
                    Size   = UDim2.new(1, -28, 1, 0),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundTransparency = 1,
                    Text  = Default,
                    Font  = Enum.Font.Gotham,
                    TextSize = 12,
                    TextColor3 = Theme.TextPrimary,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                Create("TextLabel", {
                    Parent = DDFrame,
                    Size   = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -22, 0, 0),
                    BackgroundTransparency = 1,
                    Text  = "⌄",
                    Font  = Enum.Font.GothamBold,
                    TextSize = 14,
                    TextColor3 = Theme.TextSecondary,
                })

                local selected = Default
                local open = false

                -- Dropdown popup
                local PopupFrame = Create("Frame", {
                    Parent = ScreenGui,
                    Size   = UDim2.new(0, 0, 0, 0),
                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 50,
                    ClipsDescendants = true,
                })
                MakeCorner(PopupFrame, 6)
                MakeStroke(PopupFrame, Theme.Border, 1)
                MakePadding(PopupFrame, 4, 4, 4, 4)

                local PopupList = Create("ScrollingFrame", {
                    Parent = PopupFrame,
                    Size   = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 2,
                    ScrollBarImageColor3 = Theme.ScrollBar,
                    CanvasSize = UDim2.new(0,0,0,0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 51,
                })
                MakeList(PopupList, Enum.FillDirection.Vertical, 2)

                local function CloseDropdown()
                    open = false
                    PopupFrame.Visible = false
                end

                local function OpenDropdown()
                    open = true
                    -- position popup below DDFrame
                    local absPos  = DDFrame.AbsolutePosition
                    local absSize = DDFrame.AbsoluteSize
                    local itemH   = 28
                    local maxItems = math.min(#Options, 6)
                    local popH = maxItems * itemH + 8 + (maxItems-1)*2

                    PopupFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
                    PopupFrame.Size     = UDim2.new(0, absSize.X, 0, popH)
                    PopupFrame.Visible  = true
                    PopupList:ClearAllChildren()
                    MakeList(PopupList, Enum.FillDirection.Vertical, 2)

                    for _, opt in ipairs(Options) do
                        local isSelected = (opt == selected)
                        local OptBtn = Create("TextButton", {
                            Parent = PopupList,
                            Size   = UDim2.new(1, 0, 0, itemH),
                            BackgroundColor3 = isSelected and Color3.fromRGB(45,25,65) or Theme.SurfaceHover,
                            BackgroundTransparency = isSelected and 0 or 1,
                            Text  = opt,
                            Font  = Enum.Font.Gotham,
                            TextSize = 12,
                            TextColor3 = isSelected and Theme.Accent or Theme.TextPrimary,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 52,
                        })
                        MakeCorner(OptBtn, 4)
                        MakePadding(OptBtn, 0, 0, 8, 0)
                        OptBtn.MouseEnter:Connect(function()
                            if not isSelected then
                                Tween(OptBtn, { BackgroundTransparency = 0, BackgroundColor3 = Theme.SurfaceHover })
                            end
                        end)
                        OptBtn.MouseLeave:Connect(function()
                            if not isSelected then
                                Tween(OptBtn, { BackgroundTransparency = 1 })
                            end
                        end)
                        OptBtn.MouseButton1Click:Connect(function()
                            selected = opt
                            DDLabel.Text = opt
                            CloseDropdown()
                            Callback(opt)
                        end)
                    end
                end

                local DDBtn = Create("TextButton", {
                    Parent = DDFrame,
                    Size   = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text  = "",
                    ZIndex = 5,
                })
                DDBtn.MouseButton1Click:Connect(function()
                    if open then CloseDropdown() else OpenDropdown() end
                end)

                -- close when clicking elsewhere
                UserInputService.InputBegan:Connect(function(inp)
                    if open and inp.UserInputType == Enum.UserInputType.MouseButton1 then
                        local mp = UserInputService:GetMouseLocation()
                        local abs = PopupFrame.AbsolutePosition
                        local sz  = PopupFrame.AbsoluteSize
                        if not (mp.X >= abs.X and mp.X <= abs.X+sz.X and mp.Y >= abs.Y and mp.Y <= abs.Y+sz.Y) then
                            CloseDropdown()
                        end
                    end
                end)

                local elem = {}
                function elem:Set(val) selected = val; DDLabel.Text = val end
                function elem:Get() return selected end
                return elem
            end

            -- ─────────────────────────────────────────
            -- AddBind (keybind)
            -- ─────────────────────────────────────────
            function Section:AddBind(cfg)
                cfg = cfg or {}
                local Name     = cfg.Name     or "Keybind"
                local Default  = cfg.Default  -- Enum.KeyCode or nil
                local Callback = cfg.Callback or function() end
                local AllowMouse = cfg.AllowMouse or false

                local Row = MakeRow(38)

                Create("TextLabel", {
                    Parent = Row,
                    Size   = UDim2.new(1, -120, 0, 16),
                    Position = UDim2.new(0, 12, 0.5, -8),
                    BackgroundTransparency = 1,
                    Text  = Name,
                    Font  = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = Theme.TextPrimary,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })

                local BindLabel = Default and tostring(Default.Name) or "Not Bound"
                local BindBtn = Create("TextButton", {
                    Parent = Row,
                    Size   = UDim2.new(0, 88, 0, 24),
                    Position = UDim2.new(1, -100, 0.5, -12),
                    BackgroundColor3 = Theme.InputBg,
                    Text  = BindLabel,
                    Font  = Enum.Font.Gotham,
                    TextSize = 11,
                    TextColor3 = Theme.TextSecondary,
                })
                MakeCorner(BindBtn, 5)
                MakeStroke(BindBtn, Theme.Border, 1)

                local binding = Default
                local listening = false

                BindBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    BindBtn.Text = "..."
                    Tween(BindBtn, { TextColor3 = Theme.Accent })

                    local conn
                    conn = UserInputService.InputBegan:Connect(function(inp, gpe)
                        if gpe then return end
                        conn:Disconnect()
                        listening = false

                        if inp.KeyCode == Enum.KeyCode.Escape then
                            binding = nil
                            BindBtn.Text = "Not Bound"
                            Tween(BindBtn, { TextColor3 = Theme.TextSecondary })
                        elseif inp.KeyCode ~= Enum.KeyCode.Unknown then
                            binding = inp.KeyCode
                            BindBtn.Text = inp.KeyCode.Name
                            Tween(BindBtn, { TextColor3 = Theme.TextPrimary })
                        end
                    end)
                end)

                -- trigger callback on key press
                UserInputService.InputBegan:Connect(function(inp, gpe)
                    if gpe or listening then return end
                    if binding and inp.KeyCode == binding then
                        Callback()
                    end
                end)

                local elem = {}
                function elem:Set(key)
                    binding = key
                    BindBtn.Text = key and key.Name or "Not Bound"
                end
                function elem:Get() return binding end
                return elem
            end

