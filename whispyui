--[[
    WhispyLibrary.lua  —  Obsidian-compatible GUI Library
    API matches Obsidian exactly so zero changes needed in your script.

    Window  = Library:CreateWindow({ Title, Footer, ToggleKey })
    Tab     = Window:AddTab("Name", "icon-string")
    Group   = Tab:AddLeftGroupbox("Name")  /  Tab:AddRightGroupbox("Name")

    Group:AddToggle("id", { Text, Default, Callback })
    Group:AddSlider("id", { Text, Default, Min, Max, Rounding, Callback })
    Group:AddDropdown("id", { Text, Values, Default, Callback })
    Group:AddButton({ Text, Func })
    Group:AddLabel("text"):AddKeyPicker("id", { Default, Mode, Callback })
    Group:AddColorPicker("id", { Text, Default })
    Group:AddInput("id", { Text, Default, Callback })

    Library:Notify({ Title, Description, Time })  or  Library:Notify("text", seconds)
    Library.Toggles["id"].Value  /  Library.Toggles["id"]:SetValue(bool)
    Library.Options["id"].Value  /  Library.Options["id"]:SetValue(val)
]]

