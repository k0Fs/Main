    })
    corner(5, inputF)
    stroke(T.Border, 1, inputF)

    local box = mk("TextBox", {
        Text=default, PlaceholderText=numOnly and "0" or "...",
        Size=UDim2.new(1,-8,1,0), Position=UDim2.new(0,4,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri,
        PlaceholderColor3=T.TxtDim, TextSize=12, Font=Enum.Font.GothamBold,
        ClearTextOnFocus=false, Parent=inputF,
    })

    box.FocusLost:Connect(function()
        local v = box.Text
        if numOnly then
            v = v:match("[%-]?%d+%.?%d*") or default
            if not tonumber(v) then v = default end
            box.Text = v
        end
        Library.Options[id].Value = v
        pcall(callback, v)
    end)

    return row
end

-- ================================================================
-- GROUPBOX
-- ================================================================
local function makeGroupbox(container, name)
    local wrap = mk("Frame", {
        Name="GB_"..name, Size=UDim2.new(1,0,0,0),
        BackgroundTransparency=1, Parent=container,
    })

    local hdr = mk("Frame", {
        Name="Header", Size=UDim2.new(1,0,0,26),
        BackgroundColor3=T.GbHeader, Parent=wrap,
    })
    corner(6, hdr)
    stroke(T.BorderLight, 1, hdr)

    mk("TextLabel", {
        Text=name, Size=UDim2.new(1,-10,1,0), Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1, TextColor3=T.Accent,
        TextSize=12, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=hdr,
    })

    local body = mk("Frame", {
        Name="Body", Size=UDim2.new(1,0,0,8),
        Position=UDim2.new(0,0,0,28),
        BackgroundColor3=T.GbBg, Parent=wrap,
    })
    corner(6, body)
    stroke(T.Border, 1, body)
    pad(6,8,6,8, body)

    local ll = mk("UIListLayout", {
        FillDirection=Enum.FillDirection.Vertical, SortOrder=Enum.SortOrder.LayoutOrder,
        Padding=UDim.new(0,4), Parent=body,
    })

    ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        local bh = ll.AbsoluteContentSize.Y + 12
        body.Size = UDim2.new(1,0,0,bh)
        wrap.Size = UDim2.new(1,0,0,bh+30)
    end)

    local gb = {}

    function gb:AddToggle(id, cfg)        return mkToggle(body, id, cfg) end
    function gb:AddSlider(id, cfg)        return mkSlider(body, id, cfg) end
    function gb:AddDropdown(id, cfg)      return mkDropdown(body, id, cfg) end
    function gb:AddButton(cfg)            return mkButton(body, cfg) end
    function gb:AddLabel(text)            return mkLabel(body, text) end
    function gb:AddColorPicker(id, cfg)   return mkColorPicker(body, id, cfg) end
    function gb:AddInput(id, cfg)         return mkInput(body, id, cfg) end

    -- Convenience: some scripts call AddKeyPicker directly on group
    function gb:AddKeyPicker(id, cfg)
        return mkLabel(body, (cfg and cfg.Text) or id):AddKeyPicker(id, cfg)
    end

    return gb
end

-- ================================================================
-- WINDOW
-- ================================================================
function Library:CreateWindow(cfg)
    cfg = cfg or {}
    local title     = cfg.Title     or "Whispy"
    local footer    = cfg.Footer    or ""
    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift

    -- Clean up old instance
    local cg = (gethui and gethui()) or game:GetService("CoreGui")
    if cg:FindFirstChild("WhispyGUI") then
        cg:FindFirstChild("WhispyGUI"):Destroy()
    end

    local sg = mk("ScreenGui", {
        Name="WhispyGUI", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, DisplayOrder=500,
        Parent=cg,
    })

    -- Main frame
    local mf = mk("Frame", {
        Name="Main", Size=UDim2.new(0,920,0,590),
        Position=UDim2.new(0.5,-460,0.5,-295),
        BackgroundColor3=T.Bg, BorderSizePixel=0,
        Parent=sg,
    })
    corner(10, mf)
    stroke(T.Border, 1, mf)

    -- ── Drag ──────────────────────────────────────────────────
    do
        local drag, ds, sp
        local dz = mk("Frame", {
            Size=UDim2.new(1,0,0,44), BackgroundTransparency=1, ZIndex=200, Parent=mf,
        })
        dz.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                drag=true ds=i.Position sp=mf.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
                local d=i.Position-ds
                mf.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
        end)
    end

    -- ── Header ────────────────────────────────────────────────
    local hdr = mk("Frame", {
        Name="Header", Size=UDim2.new(1,0,0,44),
        BackgroundColor3=T.Header, BorderSizePixel=0, Parent=mf,
    })
    corner(10, hdr)

    -- Fill bottom of header so only top corners rounded
    mk("Frame", {
        Size=UDim2.new(1,0,0,10), Position=UDim2.new(0,0,1,-10),
        BackgroundColor3=T.Header, BorderSizePixel=0, Parent=hdr,
    })

    mk("TextLabel", {
        Text=title, Size=UDim2.new(0,180,1,0), Position=UDim2.new(0,16,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri,
        TextSize=15, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=hdr,
    })

    -- Search box in header
    local srchF = mk("Frame", {
        Size=UDim2.new(0,230,0,28), Position=UDim2.new(0.5,-115,0.5,-14),
        BackgroundColor3=T.Surface, Parent=hdr,
    })
    corner(6, srchF)
    stroke(T.Border, 1, srchF)
    mk("TextLabel", {
        Text="🔍", Size=UDim2.new(0,24,1,0),
        BackgroundTransparency=1, TextColor3=T.TxtDim, TextSize=11, Font=Enum.Font.Gotham,
        Parent=srchF,
    })
    mk("TextBox", {
        Text="", PlaceholderText="Search...",
        Size=UDim2.new(1,-28,1,0), Position=UDim2.new(0,26,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri, PlaceholderColor3=T.TxtDim,
        TextSize=12, Font=Enum.Font.Gotham, ClearTextOnFocus=false,
        Parent=srchF,
    })

    -- Close button
    local closeBtn = mk("TextButton", {
        Text="×", Size=UDim2.new(0,28,0,28),
        Position=UDim2.new(1,-36,0.5,-14),
        BackgroundColor3=T.Surface, TextColor3=T.TxtSec,
        TextSize=16, Font=Enum.Font.GothamBold, Parent=hdr,
    })
    corner(6, closeBtn)
    closeBtn.MouseEnter:Connect(function() tw(closeBtn,{BackgroundColor3=Color3.fromRGB(180,40,40),TextColor3=T.TxtPri}) end)
    closeBtn.MouseLeave:Connect(function() tw(closeBtn,{BackgroundColor3=T.Surface,TextColor3=T.TxtSec}) end)
    closeBtn.MouseButton1Click:Connect(function() sg.Enabled=false end)

    -- ── Sidebar ───────────────────────────────────────────────
    local sidebar = mk("Frame", {
        Name="Sidebar", Size=UDim2.new(0,178,1,-44),
        Position=UDim2.new(0,0,0,44),
        BackgroundColor3=T.Sidebar, BorderSizePixel=0, Parent=mf,
    })

    -- right border
    mk("Frame", {
        Size=UDim2.new(0,1,1,0), Position=UDim2.new(1,-1,0,0),
        BackgroundColor3=T.Border, BorderSizePixel=0, Parent=sidebar,
    })

    local tabScroll = mk("ScrollingFrame", {
        Size=UDim2.new(1,0,1,-38), Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=2, ScrollBarImageColor3=T.Scrollbar,
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
        Parent=sidebar,
    })
    pad(8,6,8,6, tabScroll)
    listLayout(Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, 2, tabScroll)

    -- bottom footer in sidebar
    local sideFoot = mk("Frame", {
        Size=UDim2.new(1,0,0,38), Position=UDim2.new(0,0,1,-38),
        BackgroundTransparency=1, Parent=sidebar,
    })
    mk("Frame", {
        Size=UDim2.new(1,-16,0,1), Position=UDim2.new(0,8,0,0),
        BackgroundColor3=T.Border, BorderSizePixel=0, Parent=sideFoot,
    })
    mk("TextLabel", {
        Text="v1.0  •  "..toggleKey.Name,
        Size=UDim2.new(1,-12,1,0), Position=UDim2.new(0,10,0,2),
        BackgroundTransparency=1, TextColor3=T.TxtDim,
        TextSize=10, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=sideFoot,
    })

    -- ── Content area ──────────────────────────────────────────
    local content = mk("Frame", {
        Name="Content", Size=UDim2.new(1,-178,1,-44-24),
        Position=UDim2.new(0,178,0,44),
        BackgroundTransparency=1, ClipsDescendants=true, Parent=mf,
    })

    -- ── Footer bar ────────────────────────────────────────────
    local footBar = mk("Frame", {
        Size=UDim2.new(1,-178,0,24), Position=UDim2.new(0,178,1,-24),
        BackgroundColor3=T.Header, BorderSizePixel=0, Parent=mf,
    })
    mk("Frame", {
        Size=UDim2.new(1,0,0,1), BackgroundColor3=T.Border, BorderSizePixel=0, Parent=footBar,
    })
    mk("TextLabel", {
        Text=footer, Size=UDim2.new(1,-12,1,0), Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtDim,
        TextSize=10, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Center,
        Parent=footBar,
    })

    -- Round bottom corners of footer
    corner(10, footBar)
    mk("Frame", {
        Size=UDim2.new(1,0,0,10),
        BackgroundColor3=T.Header, BorderSizePixel=0, Parent=footBar,
    })

    -- ── Toggle key ────────────────────────────────────────────
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == toggleKey then
            sg.Enabled = not sg.Enabled
        end
    end)

    -- ── Window object ─────────────────────────────────────────
    local Window    = {}
    local allTabs   = {}
    local activeTab = nil

    local function setActive(tabObj)
        if activeTab == tabObj then return end
        if activeTab then
            activeTab._page.Visible = false
            tw(activeTab._btn, {BackgroundColor3=T.Sidebar, BackgroundTransparency=1})
            tw(activeTab._lbl, {TextColor3=T.TxtSec, Font=Enum.Font.Gotham})
            if activeTab._bar then activeTab._bar.Visible = false end
        end
        activeTab = tabObj
        tabObj._page.Visible = true
        tabObj._btn.BackgroundTransparency = 0
        tw(tabObj._btn, {BackgroundColor3=T.AccentBg})
        tw(tabObj._lbl, {TextColor3=T.TxtPri, Font=Enum.Font.GothamBold})
        if tabObj._bar then tabObj._bar.Visible = true end
    end

    -- Window:AddTab("Name", "iconString")  — matches Obsidian signature
    function Window:AddTab(tabName, _iconStr)
        -- Sidebar button
        local btn = mk("Frame", {
            Name="Tab_"..tabName, Size=UDim2.new(1,0,0,34),
            BackgroundColor3=T.AccentBg, BackgroundTransparency=1,
            Parent=tabScroll,
        })
        corner(6, btn)

        -- Active bar on left edge
        local bar = mk("Frame", {
            Size=UDim2.new(0,3,0.55,0), Position=UDim2.new(0,0,0.225,0),
            BackgroundColor3=T.Accent, BorderSizePixel=0, Visible=false,
            Parent=btn,
        })
        corner(2, bar)

        local lbl = mk("TextLabel", {
            Text=tabName, Size=UDim2.new(1,-14,1,0), Position=UDim2.new(0,12,0,0),
            BackgroundTransparency=1, TextColor3=T.TxtSec,
            TextSize=13, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
            Parent=btn,
        })

        mk("TextButton", {
            Text="", Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, ZIndex=2, Parent=btn,
        }).MouseButton1Click:Connect(function() setActive(tabObj) end)

        btn.MouseEnter:Connect(function()
            if activeTab ~= tabObj then
                btn.BackgroundTransparency = 0
                tw(btn, {BackgroundColor3=T.SurfaceHov})
            end
        end)
        btn.MouseLeave:Connect(function()
            if activeTab ~= tabObj then
                btn.BackgroundTransparency = 1
            end
        end)

        -- Tab page (two columns)
        local page = mk("ScrollingFrame", {
            Name="Page_"..tabName, Size=UDim2.new(1,-4,1,-4),
            Position=UDim2.new(0,2,0,2),
            BackgroundTransparency=1, BorderSizePixel=0,
            ScrollBarThickness=3, ScrollBarImageColor3=T.Scrollbar,
            CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
            Visible=false, Parent=content,
        })
        pad(10,10,10,10, page)

        -- Two columns container
        local cols = mk("Frame", {
            Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1, Parent=page,
        })
        mk("UIListLayout", {
            FillDirection=Enum.FillDirection.Horizontal, SortOrder=Enum.SortOrder.LayoutOrder,
            VerticalAlignment=Enum.VerticalAlignment.Top,
            Padding=UDim.new(0,8), Parent=cols,
        })

        local leftCol = mk("Frame", {
            Size=UDim2.new(0.5,-4,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1, LayoutOrder=1, Parent=cols,
        })
        listLayout(Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, 8, leftCol)

        local rightCol = mk("Frame", {
            Size=UDim2.new(0.5,-4,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1, LayoutOrder=2, Parent=cols,
        })
        listLayout(Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, 8, rightCol)

        local tabObj = {
            _btn  = btn,
            _lbl  = lbl,
            _bar  = bar,
            _page = page,
        }
        table.insert(allTabs, tabObj)

        -- AddLeftGroupbox / AddRightGroupbox — exact Obsidian API
        function tabObj:AddLeftGroupbox(gbName)
            return makeGroupbox(leftCol, gbName)
        end

        function tabObj:AddRightGroupbox(gbName)
            return makeGroupbox(rightCol, gbName)
        end

        -- legacy aliases
        function tabObj:AddGroupbox(gbName)
            return self:AddLeftGroupbox(gbName)
        end

        -- Auto-activate first tab
        if #allTabs == 1 then
            setActive(tabObj)
        end

        return tabObj
    end

    return Window
end

return Library
