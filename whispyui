-- Library:Notify({ Title, Description, Time })  OR  Library:Notify("msg", seconds)
function Library:Notify(data, altTime)
    local title, desc, time
    if type(data) == "string" then
        title = "Whispy"
        desc  = data
        time  = altTime or 3
    else
        title = data.Title or "Whispy"
        desc  = data.Description or data.Content or ""
        time  = data.Time or 3
    end

    local container = getNotifGui()

    local card = mk("Frame", {
        Name = "Notif",
        Size = UDim2.new(1, 0, 0, 64),
        BackgroundColor3 = T.NotifBg,
        Parent = container,
    })
    corner(8, card)
    stroke(T.BorderLight, 1, card)

    -- Accent strip
    local strip = mk("Frame", {
        Size = UDim2.new(0, 3, 1, -14), Position = UDim2.new(0, 0, 0, 7),
        BackgroundColor3 = T.Accent, BorderSizePixel = 0, Parent = card,
    })
    corner(3, strip)

    mk("TextLabel", {
        Text = title, Size = UDim2.new(1, -18, 0, 18), Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1, TextColor3 = T.TxtPri,
        TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
    mk("TextLabel", {
        Text = desc, Size = UDim2.new(1, -18, 0, 30), Position = UDim2.new(0, 12, 0, 28),
        BackgroundTransparency = 1, TextColor3 = T.TxtSec,
        TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, Parent = card,
    })

    -- Progress bar
    local prog = mk("Frame", {
        Size = UDim2.new(1, -4, 0, 2), Position = UDim2.new(0, 2, 1, -3),
        BackgroundColor3 = T.Accent, BorderSizePixel = 0, Parent = card,
    })
    corner(1, prog)
    TweenService:Create(prog, TweenInfo.new(time, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()

    task.delay(time, function()
        tw(card, { BackgroundTransparency = 1 }, 0.3)
        task.wait(0.35)
        card:Destroy()
    end)
end

