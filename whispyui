-- ================================================================
-- HELPERS
-- ================================================================
local function tw(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.14, Enum.EasingStyle.Quad), props):Play()
end

local function mk(cls, props)
    local o = Instance.new(cls)
    for k, v in pairs(props) do
        if k ~= "Parent" then o[k] = v end
    end
    if props.Parent then o.Parent = props.Parent end
    return o
end

local function corner(r, p)
    mk("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = p })
end

local function stroke(col, thick, p)
    mk("UIStroke", { Color = col or T.Border, Thickness = thick or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p })
end

local function pad(top, right, bot, left, p)
    mk("UIPadding", {
        PaddingTop    = UDim.new(0, top   or 0),
        PaddingRight  = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bot   or 0),
        PaddingLeft   = UDim.new(0, left  or 0),
        Parent = p,
    })
end

local function listLayout(dir, halign, spacing, p)
    mk("UIListLayout", {
        FillDirection       = dir    or Enum.FillDirection.Vertical,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        SortOrder           = Enum.SortOrder.LayoutOrder,
        Padding             = UDim.new(0, spacing or 4),
        Parent = p,
    })
end

local function autoY(frame, layout)
    local function upd()
        frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset,
            0, layout.AbsoluteContentSize.Y + frame.Size.Y.Offset - (frame.Size.Y.Offset > 0 and 0 or 0))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd)
end

local function hover(btn, norm, hov)
    btn.MouseEnter:Connect(function() tw(btn, { BackgroundColor3 = hov }) end)
    btn.MouseLeave:Connect(function() tw(btn, { BackgroundColor3 = norm }) end)
end

