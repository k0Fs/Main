-- ─── Toggle ───────────────────────────────────────────────────
local function mkToggle(parent, id, cfg)
    cfg = cfg or {}
    local label    = cfg.Text    or id
    local default  = cfg.Default or false
    local callback = cfg.Callback or function() end
    local state    = default

    local toggle = { Value = state }
    function toggle:SetValue(v)
        self.Value = v
        state = v
        -- update visuals via stored refs
        if self._refresh then self._refresh(v) end
        pcall(callback, v)
    end
    Library.Toggles[id] = toggle

    local row = mk("Frame", {
        Name = "Toggle_"..id, Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Surface, Parent = parent,
    })
    corner(6, row)
    hover(row, T.Surface, T.SurfaceHov)

    mk("TextLabel", {
        Text = label, Size = UDim2.new(1, -56, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, TextColor3 = T.TxtPri,
        TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local TW, KH = 36, 14
    local track = mk("Frame", {
        Name = "Track", Size = UDim2.new(0, TW, 0, 18),
        Position = UDim2.new(1, -(TW+10), 0.5, -9),
        BackgroundColor3 = state and T.ToggleOn or T.ToggleOff,
        Parent = row,
    })
    corner(9, track)

    local knob = mk("Frame", {
        Name = "Knob", Size = UDim2.new(0, KH, 0, KH),
        Position = UDim2.new(state and 1 or 0, state and -(KH+2) or 2, 0.5, -KH/2),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = track,
    })
    corner(KH/2, knob)

    local function refresh(v)
        tw(track, { BackgroundColor3 = v and T.ToggleOn or T.ToggleOff })
        tw(knob, { Position = UDim2.new(0, v and (TW-KH-2) or 2, 0.5, -KH/2) })
    end
    toggle._refresh = refresh

    mk("TextButton", {
        Text = "", Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Parent = row,
    }).MouseButton1Click:Connect(function()
        state = not state
        toggle.Value = state
        refresh(state)
        pcall(callback, state)
    end)

    return row
end

-- ─── Slider ───────────────────────────────────────────────────
local function mkSlider(parent, id, cfg)
    cfg = cfg or {}
    local label    = cfg.Text     or id
    local minV     = cfg.Min      or 0
    local maxV     = cfg.Max      or 100
    local default  = math.clamp(cfg.Default or minV, minV, maxV)
    local round    = cfg.Rounding or 0
    local callback = cfg.Callback or function() end
    local value    = default

    local opt = { Value = value }
    function opt:SetValue(v)
        v = math.clamp(v, minV, maxV)
        self.Value = v
        if self._refresh then self._refresh(v) end
        pcall(callback, v)
    end
    Library.Options[id] = opt

    local wrapper = mk("Frame", {
        Name = "Slider_"..id, Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = T.Surface, Parent = parent,
    })
    corner(6, wrapper)
    pad(7, 10, 7, 10, wrapper)

    local ll = mk("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5), Parent = wrapper,
    })
    ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        wrapper.Size = UDim2.new(1, 0, 0, ll.AbsoluteContentSize.Y + 14)
    end)

    -- top row: label + value
    local topRow = mk("Frame", { Size = UDim2.new(1,0,0,16), BackgroundTransparency=1, Parent=wrapper })
    mk("TextLabel", {
        Text = label, Size = UDim2.new(1,-52,1,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri,
        TextSize=13, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=topRow,
    })
    local valLbl = mk("TextLabel", {
        Text = tostring(value), Size = UDim2.new(0,50,1,0), Position=UDim2.new(1,-50,0,0),
        BackgroundTransparency=1, TextColor3=T.Accent,
        TextSize=13, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Right,
        Parent=topRow,
    })

    -- track
    local trackH = 6
    local trackF = mk("Frame", {
        Size = UDim2.new(1,0,0,trackH), BackgroundColor3=T.SliderBg, Parent=wrapper,
    })
    corner(3, trackF)

    local pct0 = (value - minV) / (maxV - minV)
    local fill = mk("Frame", {
        Size = UDim2.new(pct0,0,1,0), BackgroundColor3=T.Accent, Parent=trackF,
    })
    corner(3, fill)

    local kn = mk("Frame", {
        Size = UDim2.new(0,12,0,12),
        Position = UDim2.new(pct0,-6,0.5,-6),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = trackF,
    })
    corner(6, kn)

    local function fmtVal(v)
        if round == 0 then return tostring(math.floor(v+0.5)) end
        return string.format("%."..round.."f", v)
    end

    local function refresh(v)
        local p = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(p, 0, 1, 0)
        kn.Position = UDim2.new(p, -6, 0.5, -6)
        valLbl.Text = fmtVal(v)
    end
    opt._refresh = refresh

    local dragging = false
    local function updateFromX(ax)
        local tf  = trackF.AbsolutePosition.X
        local tw2 = trackF.AbsoluteSize.X
        local p   = math.clamp((ax - tf) / tw2, 0, 1)
        local raw = minV + (maxV - minV) * p
        local v
        if round == 0 then
            v = math.floor(raw + 0.5)
        else
            local mult = 10 ^ round
            v = math.floor(raw * mult + 0.5) / mult
        end
        v = math.clamp(v, minV, maxV)
        value = v
        opt.Value = v
        refresh(v)
        pcall(callback, v)
    end

    trackF.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return wrapper
end

-- ─── Dropdown ─────────────────────────────────────────────────
local function mkDropdown(parent, id, cfg)
    cfg = cfg or {}
    local label    = cfg.Text    or id
    local values   = cfg.Values  or {}
    local default  = cfg.Default or (values[1] or "")
    local callback = cfg.Callback or function() end
    local selected = default
    local isOpen   = false

    local opt = { Value = selected }
    function opt:SetValue(v)
        self.Value = v
        selected = v
        if self._setLabel then self._setLabel(v) end
        pcall(callback, v)
    end
    Library.Options[id] = opt

    local wrapper = mk("Frame", {
        Name = "DD_"..id, Size = UDim2.new(1,0,0,32),
        BackgroundColor3 = T.Surface, ClipsDescendants = false, ZIndex = 5, Parent = parent,
    })
    corner(6, wrapper)
    hover(wrapper, T.Surface, T.SurfaceHov)

    mk("TextLabel", {
        Text = label, Size = UDim2.new(0.5,-8,1,0), Position = UDim2.new(0,10,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri,
        TextSize=13, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=5, Parent=wrapper,
    })

    local sel = mk("Frame", {
        Size=UDim2.new(0,115,0,22), Position=UDim2.new(1,-123,0.5,-11),
        BackgroundColor3=T.InputBg, ZIndex=5, Parent=wrapper,
    })
    corner(5, sel)
    stroke(T.Border, 1, sel)

    local selLbl = mk("TextLabel", {
        Text=selected, Size=UDim2.new(1,-20,1,0), Position=UDim2.new(0,6,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtPri,
        TextSize=12, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=5, Parent=sel,
    })
    opt._setLabel = function(v) selLbl.Text = v end

    mk("TextLabel", {
        Text="▼", Size=UDim2.new(0,16,1,0), Position=UDim2.new(1,-18,0,0),
        BackgroundTransparency=1, TextColor3=T.TxtDim, TextSize=9, Font=Enum.Font.Gotham,
        ZIndex=5, Parent=sel,
    })

    -- dropdown list
    local list = mk("Frame", {
        Name="List", Size=UDim2.new(0,115,0,0),
        Position=UDim2.new(1,-123,1,4),
        BackgroundColor3=T.GbBg, Visible=false, ZIndex=20, ClipsDescendants=true,
        Parent=wrapper,
    })
    corner(6, list)
    stroke(T.Border, 1, list)
    local ll = mk("UIListLayout", { FillDirection=Enum.FillDirection.Vertical,
        SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,2), Parent=list })
    pad(4,4,4,4, list)

    local function buildList()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, v in ipairs(values) do
            local active = v == selected
            local item = mk("TextButton", {
                Text=v, Size=UDim2.new(1,0,0,24),
                BackgroundColor3 = active and T.AccentBg or T.Surface,
                TextColor3 = active and T.Accent or T.TxtPri,
                TextSize=12, Font = active and Enum.Font.GothamBold or Enum.Font.Gotham,
                ZIndex=20, Parent=list,
            })
            corner(4, item)
            pad(0,6,0,6, item)
            item.TextXAlignment = Enum.TextXAlignment.Left
            item.MouseButton1Click:Connect(function()
                selected = v
                selLbl.Text = v
                opt.Value = v
                isOpen = false
                list.Visible = false
                pcall(callback, v)
                buildList()
            end)
        end
        list.Size = UDim2.new(0, 115, 0, ll.AbsoluteContentSize.Y + 8)
    end
    buildList()

    mk("TextButton", {
        Text="", Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, ZIndex=6, Parent=sel,
    }).MouseButton1Click:Connect(function()
        isOpen = not isOpen
        list.Visible = isOpen
    end)

    return wrapper
end

-- ─── Button ───────────────────────────────────────────────────
local function mkButton(parent, cfg)
    cfg = cfg or {}
    local label = cfg.Text or "Button"
    local func  = cfg.Func or cfg.Callback or function() end

    local btn = mk("TextButton", {
        Name="Button", Text=label, Size=UDim2.new(1,0,0,30),
        BackgroundColor3=T.AccentDim, TextColor3=T.TxtPri,
        TextSize=13, Font=Enum.Font.GothamBold, Parent=parent,
    })
    corner(6, btn)
    btn.MouseEnter:Connect(function() tw(btn, {BackgroundColor3=T.Accent}) end)
    btn.MouseLeave:Connect(function() tw(btn, {BackgroundColor3=T.AccentDim}) end)
    btn.MouseButton1Click:Connect(function()
        tw(btn, {BackgroundColor3=T.AccentHov})
        task.delay(0.12, function() tw(btn, {BackgroundColor3=T.AccentDim}) end)
        pcall(func)
    end)
    return btn
end

-- ─── Label + KeyPicker ────────────────────────────────────────
local function mkLabel(parent, text)
    local row = mk("Frame", {
        Name="LabelRow", Size=UDim2.new(1,0,0,28),
        BackgroundTransparency=1, Parent=parent,
    })

    local lbl = mk("TextLabel", {
        Text=text or "", Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1, TextColor3=T.TxtSec,
        TextSize=12, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=row,
    })

    local labelObj = {}

    function labelObj:AddKeyPicker(id, kcfg)
        kcfg = kcfg or {}
        local defKey   = kcfg.Default  or "None"
        local callback = kcfg.Callback or function() end

        local currentKey = nil
        if defKey ~= "None" then
            pcall(function() currentKey = Enum.KeyCode[defKey] end)
        end
        local listening = false

        Library.Options[id] = { Value = currentKey }

        -- Shrink label to make room
        lbl.Size = UDim2.new(1, -112, 1, 0)

        local bindF = mk("Frame", {
            Name="Bind_"..id, Size=UDim2.new(0,104,0,22),
            Position=UDim2.new(1,-104,0.5,-11),
            BackgroundColor3=T.InputBg, Parent=row,
        })
        corner(5, bindF)
        stroke(T.Border, 1, bindF)

        local bindBtn = mk("TextButton", {
            Text = currentKey and currentKey.Name or "None",
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            TextColor3=T.TxtSec, TextSize=12, Font=Enum.Font.Gotham,
            Parent=bindF,
        })

        bindBtn.MouseButton1Click:Connect(function()
            listening = true
            bindBtn.Text = "Press key..."
            bindBtn.TextColor3 = T.Accent
        end)

        UserInputService.InputBegan:Connect(function(inp, gpe)
            if listening then
                listening = false
                if inp.KeyCode == Enum.KeyCode.Escape then
                    currentKey = nil
                    bindBtn.Text = "None"
                    bindBtn.TextColor3 = T.TxtDim
                    Library.Options[id].Value = nil
                    return
                end
                if inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    bindBtn.Text = inp.KeyCode.Name
                    bindBtn.TextColor3 = T.TxtSec
                    Library.Options[id].Value = inp.KeyCode
                end
                return
            end
            -- Fire callback when key pressed (not while typing in a textbox)
            if not gpe and currentKey and inp.KeyCode == currentKey then
                pcall(callback)
            end
        end)

        return labelObj
    end

    return labelObj
end

