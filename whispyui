                    TextSize = 13,
                    TextColor3 = isAccent and Color3.fromRGB(255,255,255) or Theme.TextPrimary,
                })
                MakeCorner(Btn, 5)
                if not isAccent then
                    MakeStroke(Btn, Theme.Border, 1)
                end

                Btn.MouseEnter:Connect(function()
                    Tween(Btn, { BackgroundColor3 = isAccent and Theme.Accent or Theme.ButtonHover })
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(Btn, { BackgroundColor3 = isAccent and Theme.AccentButton or Theme.ButtonBg })
                end)
                Btn.MouseButton1Click:Connect(function()
                    Tween(Btn, { BackgroundColor3 = isAccent and Theme.AccentDark or Theme.Border })
