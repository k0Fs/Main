            -- ─────────────────────────────────────────
            -- AddSlider
            -- ─────────────────────────────────────────
            function Section:AddSlider(cfg)
                cfg = cfg or {}
                local Name     = cfg.Name     or "Slider"
                local Desc     = cfg.Desc
                local Min      = cfg.Min      or 0
                local Max      = cfg.Max      or 100
                local Default  = cfg.Default  or Min
                local Step     = cfg.Step     or 1
                local Callback = cfg.Callback or function() end
                local Suffix   = cfg.Suffix   or ""

                Default = math.clamp(Default, Min, Max)
                local rowH = Desc and 52 or 44
                local Row = MakeRow(rowH)

                Create("TextLabel", {
                    Parent = Row,
                    Size   = UDim2.new(1, -80, 0, 16),
                    Position = UDim2.new(0, 12, 0, Desc and 8 or 6),
                    BackgroundTransparency = 1,
                    Text  = Name,
                    Font  = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = Theme.TextPrimary,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                if Desc then
                    Create("TextLabel", {
                        Parent = Row,
                        Size   = UDim2.new(1, -80, 0, 13),
                        Position = UDim2.new(0, 12, 0, 25),
                        BackgroundTransparency = 1,
                        Text  = Desc,
                        Font  = Enum.Font.Gotham,
                        TextSize = 10,
                        TextColor3 = Theme.TextSecondary,
                        TextXAlignment = Enum.TextXAlignment.Left,
                    })
                end

                -- Value display
                local ValDisplay = Create("Frame", {
                    Parent = Row,
                    Size   = UDim2.new(0, 40, 0, 22),
                    Position = UDim2.new(1, -52, 0, Desc and 8 or 5),
                    BackgroundColor3 = Theme.InputBg,
                })
                MakeCorner(ValDisplay, 4)
                MakeStroke(ValDisplay, Theme.Border, 1)
                local ValLabel = Create("TextLabel", {
                    Parent = ValDisplay,
                    Size   = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text  = tostring(Default) .. Suffix,
                    Font  = Enum.Font.GothamBold,
                    TextSize = 11,
                    TextColor3 = Theme.TextPrimary,
                })

                -- Slider track
                local SliderYOffset = Desc and 36 or 28
                local TrackBg = Create("Frame", {
                    Parent = Row,
                    Size   = UDim2.new(1, -60, 0, 6),
                    Position = UDim2.new(0, 12, 0, SliderYOffset),
                    BackgroundColor3 = Theme.SliderBg,
                })
                MakeCorner(TrackBg, 3)

                local pct = (Default - Min) / (Max - Min)
                local Fill = Create("Frame", {
                    Parent = TrackBg,
                    Size   = UDim2.new(pct, 0, 1, 0),
                    BackgroundColor3 = Theme.SliderFill,
                })
                MakeCorner(Fill, 3)

                local Thumb = Create("Frame", {
                    Parent = TrackBg,
                    Size   = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(pct, -7, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                })
                MakeCorner(Thumb, 7)

                local value = Default
                local draggingSlider = false

                local function UpdateSlider(x)
                    local abs = TrackBg.AbsolutePosition
                    local sz  = TrackBg.AbsoluteSize
                    local t   = math.clamp((x - abs.X) / sz.X, 0, 1)
                    local raw = Min + (Max - Min) * t
                    local stepped = math.floor(raw / Step + 0.5) * Step
                    value = math.clamp(stepped, Min, Max)
                    local newPct = (value - Min) / (Max - Min)
                    Fill.Size     = UDim2.new(newPct, 0, 1, 0)
                    Thumb.Position = UDim2.new(newPct, -7, 0.5, -7)
                    ValLabel.Text = tostring(math.floor(value * 100 + 0.5) / 100) .. Suffix
                    Callback(value)
                end

                TrackBg.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSlider = true
                        UpdateSlider(inp.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(inp)
                    if draggingSlider and inp.UserInputType == Enum.UserInputType.MouseMovement then
                        UpdateSlider(inp.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSlider = false
                    end
                end)

                local elem = {}
                function elem:Set(val)
                    value = math.clamp(val, Min, Max)
                    local p = (value - Min) / (Max - Min)
                    Fill.Size      = UDim2.new(p, 0, 1, 0)
                    Thumb.Position = UDim2.new(p, -7, 0.5, -7)
                    ValLabel.Text  = tostring(value) .. Suffix
                end
                function elem:Get() return value end
                return elem
            end

